# Database

MYSQL_USER=user
MYSQL_PASSWORD=user_password
MYSQL_ROOT=root
MYSQL_ROOT_PASSWORD=root_password

MYSQL_DATABASE=dbcamagru
MYSQL_PORT=3306
MYSQL_DSN="mysql:host=mysql;dbname=${MYSQL_DATABASE};charset=utf8;port=${MYSQL_PORT};"

URL=http://localhost:8080

# Demo
# Compte partage, cree par `php /var/www/html/seed.demo.php`.
# DEMO_USERNAME vide desactive tout le mode demo (badge, dialog, restrictions).

DEMO_USERNAME=demo
DEMO_EMAIL=demo@demo.com
DEMO_PASSWORD=demo